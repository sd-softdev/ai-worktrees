{
  "name": "agent-workspace",
  "version": "0.7.0",
  "description": "A terminal-first workspace for parallel development with Git worktrees.",
  "main": "out/main/index.js",
  "author": {
    "name": "sd-softdev",
    "email": "sd-softdev@users.noreply.github.com"
  },
  "homepage": "https://github.com/sd-softdev/ai-worktrees",
  "repository": {
    "type": "git",
    "url": "https://github.com/sd-softdev/ai-worktrees.git"
  },
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": "^22.16.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "npm run build:remote && electron-vite dev",
    "build": "npm run typecheck && electron-vite build && npm run build:remote",
    "build:remote": "node scripts/build-remote.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:packaged": "node scripts/smoke.mjs --packaged",
    "test:ssh": "node scripts/ssh-smoke.mjs --packaged",
    "test:ssh-client": "node scripts/ssh-client-smoke.mjs",
    "test:updates": "node scripts/update-smoke.mjs",
    "test:install": "node scripts/install-test.mjs",
    "postinstall": "electron-builder install-app-deps",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "format": "prettier --write src tests scripts .github *.json *.ts *.mts *.yml README.md",
    "format:check": "prettier --check src tests scripts .github *.json *.ts *.mts *.yml README.md",
    "generate:icon": "npm run build && node scripts/generate-icon.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.68.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
